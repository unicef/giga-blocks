<html>
  <head>
    <title>Giga Blocks NFT Claim</title>
    <link href='https://fonts.googleapis.com/icon?family=Material+Icons' rel='stylesheet' />
  </head>
  <body style='font-family:IBM Plex Sans; padding: 40px; display: flex; justify-content: center;'>
    <div
      style='max-width: 900px; background-color: #FDEDF2; padding: 30px; border-radius: 16px; box-shadow: 0 2px 8px rgba(0,0,0,0.05);'
    >

      <!-- Carbon Favorite Icon -->
      <div
        style='width: 60px; height: 60px; background-color: #316bff; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 2rem;'
      >

        <svg
          xmlns='http://www.w3.org/2000/svg'
          style='fill: rgb(238, 236, 236);'
          width='32'
          height='32'
          viewBox='0 0 32 32'
        >
          <path
            d='M23.49 4A7.43 7.43 0 0 0 16 7.35 7.43 7.43 0 0 0 8.51 4 7.48 7.48 0 0 0 1 11.6c0 4.14 3.44 7.51 8.64 12.25a53.06 53.06 0 0 0 6.13 5.14.9.9 0 0 0 1.06 0 53.06 53.06 0 0 0 6.13-5.14C27.56 19.11 31 15.74 31 11.6A7.48 7.48 0 0 0 23.49 4Z'
          />
        </svg>
      </div>

      {{! <!-- Icon -->
      <div style="width: 60px; height: 60px; background-color: #316bff; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
        <span class="material-icons" style="font-size: 32px; color: white;">favorite</span>
      </div> }}

      <!-- Heading -->
      <h2 style='font-size: 42px; margin: 0 0 20px; font-weight: 500;'>
        🎉 Thank You for Supporting Giga Blocks – Claim Your NFT for
        {{school}}
      </h2>

      <!-- Body Text -->
      <p style='font-size: 24px; line-height: 1.6;'>
        Thank you for activating
        {{school}}
        and contributing to Giga Blocks' mission to connect every school to the internet. Your
        support brings us closer to a world where every child has access to quality education.<br
        /><br />
        As a token of our appreciation, we've prepared a unique NFT representing your contribution
        to
        {{school}}.
      </p>

      <!-- Claim Link -->
      <p style='font-size: 16px; margin-bottom: 30px;'>
        👉
        <a href={{link}} style='color: #316bff; text-decoration: underline;'>[Click Here to Claim
          Your NFT]</a>
      </p>

      <!-- Footer -->
      <p style='font-size: 16px; margin-bottom: 10px;'>Together, we're building a more connected and
        inclusive future.</p>
      <p style='font-size: 16px; margin-bottom: 40px;'>Warm regards,<br />The Giga Team</p>

      <!-- Logo -->
      <strong style='font-size: 16px;'>Giga Blocks</strong>
    </div>
  </body>
</html>