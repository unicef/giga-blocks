<html>
  <body
    style='margin: 0; padding: 0; background-color: #fce7f3; font-family: Poppins, Helvetica, Arial, sans-serif;'
  >
    <div style='width: 100%; padding: 40px 20px; box-sizing: border-box;'>
      <div
        style='max-width: 600px; margin: auto; background-color: #fce7f3; border-radius: 12px; text-align: center; padding: 40px 30px;'
      >

        <!-- Heart Icon -->
        <div
          style='background-color: #db2777; color: white; font-size: 32px; width: 64px; height: 64px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: auto;'
        >
          ❤️
        </div>

        <!-- Info Message -->
        <p style='font-size: 14px; color: #374151; margin: 0 auto 20px; max-width: 90%;'>
          Thank you for supporting globa; education by activating this school on Giga Block. As a
          token of appreciation, you can now clain your commemorative NFT.
        </p>

        <!-- Verification Link -->
        <p style='margin-top: 10px;'>
          <a
            href='{{link}}'
            style='color: #2563eb; font-size: 14px; font-weight: 500; text-decoration: underline;'
          >
            Click here to verify your email
          </a>
        </p>

      </div>

      <!-- Footer -->
      <div style='text-align: center; font-size: 12px; color: #888; margin-top: 40px;'>
        <p style='margin: 4px 0;'>
          <a href='#' style='color: #888; text-decoration: underline;' target='_blank'>View Web
            Version</a>
          &nbsp;|&nbsp;
          <a href='#' style='color: #888; text-decoration: underline;' target='_blank'>Email
            Preferences</a>
          &nbsp;|&nbsp;
          <a href='#' style='color: #888; text-decoration: underline;' target='_blank'>Privacy
            Policy</a>
        </p>
        <p style='margin: 4px 0;'>
          If you have any questions please contact us at
          <a
            href='mailto:{{emailurl}}'
            style='color: #888; text-decoration: underline;'
          >{{emailurl}}</a>
        </p>
        <p style='margin-top: 30px; font-weight: 600; color: #111;'>Giga Blocks</p>
      </div>
    </div>
  </body>
</html>